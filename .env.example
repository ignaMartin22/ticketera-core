# Copiar a .env y completar. .env está en .gitignore: no se commitea.

# Desarrollo local ("1" habilita SECRET_KEY insegura y cookies sin flag secure).
# Descomentar solo en desarrollo. Nunca en producción.
# DJANGO_DEBUG=1

# Base local en Docker. Se usan solo si DATABASE_URL no está definida.
POSTGRES_DB=ticketera
POSTGRES_USER=ticketera
POSTGRES_PASSWORD=<contraseña de desarrollo>
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer

# Neon: connection string del panel (botón Connect del branch).
# DATABASE_URL=postgresql://usuario:password@ep-xxxx.sa-east-1.aws.neon.tech/ticketera?sslmode=require&channel_binding=require

# Producción (además de DATABASE_URL):
# DJANGO_SECRET_KEY=<generar una clave aleatoria>
# DJANGO_ALLOWED_HOSTS=midominio.com,www.midominio.com
