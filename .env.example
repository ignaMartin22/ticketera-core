# Copiar a .env y completar. .env está en .gitignore: no se commitea.

# Desarrollo local ("1" habilita SECRET_KEY insegura y cookies sin flag secure).
# Descomentar solo en desarrollo. Nunca en producción.
# DJANGO_DEBUG=1

# Base local en Docker. Se usan solo si DATABASE_URL no está definida.
POSTGRES_DB=ticketera
POSTGRES_USER=ticketera
POSTGRES_PASSWORD=<contraseña de desarrollo>
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer

# Neon: connection string del panel (botón Connect del branch).
# DATABASE_URL=postgresql://usuario:password@ep-xxxx.sa-east-1.aws.neon.tech/ticketera?sslmode=require&channel_binding=require

# Mail de entradas. Sin DJANGO_EMAIL_HOST y con DJANGO_DEBUG=1, los mails se imprimen en la consola.
# DJANGO_EMAIL_HOST=smtp.proveedor.com
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=TicketJuy <entradas@midominio.com>

# Producción (además de DATABASE_URL):
# DJANGO_SECRET_KEY=<generar una clave aleatoria>
# DJANGO_ALLOWED_HOSTS=midominio.com,www.midominio.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://midominio.com,https://www.midominio.com
# Solo detrás de un proxy que termina TLS y sanea X-Forwarded-Proto:
# DJANGO_BEHIND_PROXY=1
# DJANGO_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_PRELOAD=1

# Macro Click de Pago y Nave: las credenciales son de cada boliche y se cargan desde el panel.
# Necesitan PUBLIC_API_URL y MP_TOKEN_ENCRYPTION_KEY. Las direcciones de cada entorno ya
# vienen por defecto; ver docs/specs/pasarelas.md si el banco informa otras.
# MACRO_CLICK_URL=https://botonpp.macroclickpago.com.ar/
# NAVE_API_URL=https://api.ranty.io/api
