# Copiar a deploy/.env (chmod 600). El .env real NUNCA se commitea.

# --- Django ---
# Clave secreta. Generar: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiar-por-un-valor-generado
# Debe quedar vacío o en 0 en el servidor (1 = modo desarrollo, NO usar acá).
DJANGO_DEBUG=0
# Hosts permitidos, separados por coma.
DJANGO_ALLOWED_HOSTS=api.66-97-35-67.sslip.io
# Orígenes HTTPS confiables para CSRF (admin), separados por coma.
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.66-97-35-67.sslip.io
# 1 cuando hay un proxy HTTPS delante (Caddy): confía en X-Forwarded-Proto.
DJANGO_BEHIND_PROXY=1
# 1 = redirigir HTTP a HTTPS desde Django. Dejar en 0 en la VPS de pruebas: Caddy ya redirige
# y, con 1, el healthcheck interno por HTTP recibiría redirecciones.
DJANGO_SSL_REDIRECT=0
# Segundos de HSTS (0 = desactivado). Subir de a poco (p. ej. 3600) una vez probado el dominio con HTTPS.
DJANGO_HSTS_SECONDS=0
# 1 = agregar "preload" a HSTS (solo con DJANGO_HSTS_SECONDS alto y el dominio en la lista de preload).
DJANGO_HSTS_PRELOAD=0

# --- Postgres (contenedor db; web se conecta solo, no hace falta POSTGRES_HOST) ---
POSTGRES_DB=ticketjuy
POSTGRES_USER=ticketjuy
# Generar: openssl rand -hex 24   (solo hex: evita caracteres problemáticos)
POSTGRES_PASSWORD=cambiar-por-un-valor-generado
# Opcional (solo con base externa): POSTGRES_HOST, POSTGRES_PORT, POSTGRES_SSLMODE

# --- URLs de la aplicación ---
# URL pública del backend (la usan los links de retorno y webhooks).
PUBLIC_API_URL=https://api.66-97-35-67.sslip.io
# URL base del front, para los links que llevan al comprador de vuelta.
# Mercado Pago devuelve al comprador a <FRONT_BASE_URL>/<boliche>/<evento>/pedido/<id>.
# Front de pruebas (Railway). Sin barra al final.
FRONT_BASE_URL=https://ticketjuy-production.up.railway.app

# --- Mail ---
# Mail de entradas al comprador (SMTP del proveedor: Resend, SendGrid, Brevo, etc.).
# Sin DJANGO_EMAIL_HOST no sale ningún mail: quedan pendientes para `manage.py send_ticket_emails`.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
# SMTP de respaldo (opcional, por ejemplo Brevo): si el principal falla (cupo diario agotado,
# caída), el mail sale en el momento por este. Vacío: sin respaldo. Ver docs/mail.md.
DJANGO_EMAIL_FALLBACK_HOST=
DJANGO_EMAIL_FALLBACK_PORT=587
DJANGO_EMAIL_FALLBACK_HOST_USER=
DJANGO_EMAIL_FALLBACK_HOST_PASSWORD=
DJANGO_EMAIL_FALLBACK_USE_TLS=1
# Remitente de un dominio verificado en el proveedor (SPF y DKIM), o los mails caen en spam.
DJANGO_DEFAULT_FROM_EMAIL=TicketJuy <entradas@midominio.com>
# Casilla que alguien lee, para las respuestas de los compradores ("no me anda el QR").
DJANGO_TICKETS_REPLY_TO=

# --- Mercado Pago (opcionales: sin ellas las rutas de conexión responden 503) ---
# App ID de la aplicación de Mercado Pago.
MP_APP_ID=0000000000000000
# Client secret de la aplicación de Mercado Pago.
MP_CLIENT_SECRET=cambiar-por-el-secret-de-mp
# Callback OAuth registrado en la app de Mercado Pago.
MP_REDIRECT_URI=https://api.66-97-35-67.sslip.io/api/v1/mercadopago/oauth/callback/
# Clave para cifrar tokens. Generar: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MP_TOKEN_ENCRYPTION_KEY=cambiar-por-un-valor-generado
# Clave secreta de firma de los webhooks (panel de Mercado Pago, sección Webhooks). Sin ella el webhook responde 503.
MP_WEBHOOK_SECRET=cambiar-por-la-clave-de-firma
# A dónde vuelve el boliche tras conectar Mercado Pago (ruta o URL del front).
MP_CONNECT_RETURN_URL=/
# 1 = aceptar tokens de prueba de MP (solo para pruebas). En producción va en 0.
MP_TEST_TOKENS=0
# 1 = las cuentas de cobro en modo prueba (live_mode falso) se ofrecen, cobran y emiten entradas.
# Con 0 (producción) una cuenta de prueba no cobra y un pago aprobado de ella no emite entradas.
PAYMENTS_ALLOW_TEST_MODE=0

# --- Seguridad del alta de pedidos (opcionales) ---
# Clave compartida con el servidor del front (header X-Front-Key). Si se define, el alta de pedidos
# la exige (403 forbidden sin ella) y X-Buyer-Ip pasa a ser la IP confiable del comprador.
# Generar: python3 -c "import secrets; print(secrets.token_urlsafe(32))". Vacía = no se exige.
FRONT_API_KEY=
# Topes por evento (valores por defecto):
# MAX_PENDING_ORDERS_PER_EMAIL=2
# MAX_PENDING_ORDERS_PER_IP=5
# MAX_FREE_TICKETS_PER_EMAIL=4
# MAX_FREE_TICKETS_PER_IP=8
# PAYMENT_SYNC_MIN_SECONDS=15
# PAYMENT_SYNC_MAX_AGE_HOURS=24
# MAX_GUESTS_PER_PROMOTER_PER_HOUR=200

# --- Puerto local (opcional) ---
# Puerto en 127.0.0.1 donde publica web. Por defecto 8001.
WEB_PORT=8001
