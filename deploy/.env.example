# Copiar a deploy/.env (chmod 600). El .env real NUNCA se commitea.

# --- Django ---
# Clave secreta. Generar: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiar-por-un-valor-generado
# Debe quedar vacío o en 0 en el servidor (1 = modo desarrollo, NO usar acá).
DJANGO_DEBUG=0
# Hosts permitidos, separados por coma.
DJANGO_ALLOWED_HOSTS=api.66-97-35-67.sslip.io
# Orígenes HTTPS confiables para CSRF (admin), separados por coma.
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.66-97-35-67.sslip.io
# 1 cuando hay un proxy HTTPS delante (Caddy): confía en X-Forwarded-Proto.
DJANGO_BEHIND_PROXY=1

# --- Postgres (contenedor db; web se conecta solo, no hace falta POSTGRES_HOST) ---
POSTGRES_DB=ticketjuy
POSTGRES_USER=ticketjuy
# Generar: openssl rand -hex 24   (solo hex: evita caracteres problemáticos)
POSTGRES_PASSWORD=cambiar-por-un-valor-generado
# Opcional (solo con base externa): POSTGRES_HOST, POSTGRES_PORT, POSTGRES_SSLMODE

# --- URLs de la aplicación ---
# URL pública del backend (la usan los links de retorno y webhooks).
PUBLIC_API_URL=https://api.66-97-35-67.sslip.io
# URL base del front, para los links que llevan al comprador de vuelta.
FRONT_BASE_URL=https://ejemplo-front.vercel.app

# --- Mercado Pago (opcionales: sin ellas las rutas de conexión responden 503) ---
# App ID de la aplicación de Mercado Pago.
MP_APP_ID=0000000000000000
# Client secret de la aplicación de Mercado Pago.
MP_CLIENT_SECRET=cambiar-por-el-secret-de-mp
# Callback OAuth registrado en la app de Mercado Pago.
MP_REDIRECT_URI=https://api.66-97-35-67.sslip.io/api/v1/mercadopago/oauth/callback/
# Clave para cifrar tokens. Generar: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MP_TOKEN_ENCRYPTION_KEY=cambiar-por-un-valor-generado
# Clave secreta de firma de los webhooks (panel de Mercado Pago, sección Webhooks). Sin ella el webhook responde 503.
MP_WEBHOOK_SECRET=cambiar-por-la-clave-de-firma
# A dónde vuelve el boliche tras conectar Mercado Pago (ruta o URL del front).
MP_CONNECT_RETURN_URL=/
# 1 = aceptar tokens de prueba de MP (solo para pruebas, no en producción real).
MP_TEST_TOKENS=1

# --- Puerto local (opcional) ---
# Puerto en 127.0.0.1 donde publica web. Por defecto 8001.
WEB_PORT=8001
